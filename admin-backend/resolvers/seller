    verifySellerPasswordOtp: async (_, { email, otp }, { pubsub }) => {
      try {
        if (!email || !isValidEmail(email)) {
          throw new Error("Valid email is required");
        }

        if (!otp || otp.length !== 6) {
          throw new Error("Valid 6-digit OTP is required");
